{
  "name": "banger-roulette",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "vite build",
    "size:check": "node scripts/bundle-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:e2e": "playwright test && playwright test --config playwright.csp.config.ts",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "lighthouse": "pnpm lighthouse:desktop && pnpm lighthouse:mobile",
    "lighthouse:desktop": "lhci autorun --config=./lighthouserc.cjs",
    "lighthouse:mobile": "LHCI_DEVICE=mobile lhci autorun --config=./lighthouserc.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "i18next": "26.4.4",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "ws": "8.22.0"
  }
}
